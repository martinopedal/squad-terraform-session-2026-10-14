# Dependencies and local build caches
node_modules/
.cache/
__pycache__/
*.pyc

# Terraform state, downloaded providers, saved plans, and real environment inputs
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
*.tfplan.json
*.tfvars
*.tfvars.json
*.backend.hcl
backend.hcl
crash.log
crash.*.log
!*.tfvars.example
!*.tfvars.json.example
!*.backend.hcl.example

# Credentials and machine-specific configuration
.env
.env.*
!.env.example
*.pem
*.pfx
*.p12
*.key
kubeconfig
kubeconfig.*
.azure/
.copilot/
.mcp.json

# Raw/private recording material is never public by default.
recordings/
private/
evidence/private/

# Large unreviewed captures; approved media is explicitly staged after review.
*.mkv
*.mov
*.mp4
*.wav

# Keep validation artifacts local; publish only the sanitized reports.
test-results/
playwright-report/
screenshots/
qa/

# Private working material must not be copied into the public repository.
workstreams/
archive/
demo/policy-evidence/
*.tfbackend
tfplan
takes/
.squad/.first-run
.squad/memory/audit.jsonl
.squad/memory/index.json
# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Disposable native-agent checks and local-only operator configuration
.agentic-checks/
.vscode/mcp.json
*.tfrc
.terraformrc
