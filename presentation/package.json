{
  "name": "copilot-squad-terraform-presentation",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Offline Reveal.js conference presentation for Martin Opedal and Haflidi Fridthjofsson.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "python -m http.server 4173 --bind 127.0.0.1 --directory ..",
    "preview": "python scripts/preview.py",
    "test": "node --test --test-reporter=spec tests\\media-policy.test.mjs tests\\short-deck.test.mjs && .venv\\Scripts\\python.exe tests\\check_deck.py"
  },
  "dependencies": {
    "marked": "15.0.12",
    "reveal.js": "5.2.1"
  },
  "devDependencies": {
    "@fontsource/roboto": "5.3.0",
    "axe-core": "4.10.3"
  },
  "engines": {
    "node": ">=22"
  }
}
